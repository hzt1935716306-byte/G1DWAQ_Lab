{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_eval_final/protocol/schema.json",
  "title": "Paper evaluation v1.3 (single frozen checkpoint) trial record",
  "type": "object",
  "required": [
    "evaluation_system", "trial_id", "experiment_id", "stage", "method",
    "train_seed", "eval_seed", "checkpoint_sha256", "evaluation_code_commit",
    "protocol_version", "protocol_hash", "manifest_hash", "metrics_config_hash",
    "physics_profile_hash", "asset_hash", "simulator_version",
    "termination_kind", "task_outcome", "failure_reason", "push_applied",
    "scheduled", "executed", "valid", "eval_invalid", "cert_invalid"
  ],
  "properties": {
    "evaluation_system": {"const": "paper_eval_final"},
    "trial_id": {"type": "string", "minLength": 1},
    "experiment_id": {"enum": [1, 2, 3]},
    "stage": {"enum": ["screening", "pilot", "formal"]},
    "method": {"type": "string"},
    "train_seed": {"type": "integer"},
    "eval_seed": {"type": "integer"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "protocol_version": {"const": "1.2"},
    "protocol_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physics_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "simulator_version": {"type": "string", "minLength": 1},
    "termination_kind": {"enum": ["HORIZON_REACHED", "PHYSICAL_RESET", "PROTOCOL_STOP", "EVALUATION_ABORT"]},
    "task_outcome": {"enum": ["SUCCESS", "FAILURE", "INVALID"]},
    "failure_reason": {"type": ["string", "null"]},
    "recovery_time": {"type": ["number", "null"]},
    "Nmin": {"type": ["integer", "null"]},
    "margin": {"type": ["number", "null"]},
    "margin_raw": {"type": ["number", "null"]},
    "margin_storage_dtype": {"enum": ["float64", null]},
    "margin_was_rounded": {"type": ["boolean", "null"]},
    "margin_group": {"enum": ["LOWER", "MIDDLE", "UPPER", null]},
    "margin_boundary_id": {"type": ["string", "null"]},
    "nmin_q1": {"type": ["number", "null"]},
    "nmin_q2": {"type": ["number", "null"]},
    "sample_role": {"enum": ["calibration", "pilot_analysis", "formal_analysis", null]},
    "sample_roles": {"type": "array", "items": {"enum": ["calibration", "pilot_analysis", "formal_analysis"]}},
    "calibration_only": {"type": "boolean"},
    "margin_degenerate": {"type": "boolean"},
    "calibration_manifest_hash": {"type": ["string", "null"]},
    "evaluation_manifest_hash": {"type": ["string", "null"]},
    "scheduled": {"const": 1},
    "executed": {"enum": [0, 1]},
    "valid": {"enum": [0, 1]},
    "eval_invalid": {"enum": [0, 1]},
    "cert_invalid": {"enum": [0, 1]},
    "push_applied": {"type": "boolean"}
  },
  "additionalProperties": true
}
